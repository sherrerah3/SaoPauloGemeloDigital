{
  "name": "sao-paulo-gemelo-digital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "datos": ".venv/bin/python ingesta/todo.py",
    "verificar": "cd ingesta && ../.venv/bin/python verificar.py",
    "datos:descargar": ".venv/bin/python ingesta/crudos.py descargar",
    "datos:web": ".venv/bin/python ingesta/todo.py --solo-web",
    "lint": "biome check . && .venv/bin/ruff check ingesta && .venv/bin/ruff format --check ingesta",
    "formato": "biome check --write . && .venv/bin/ruff check --fix ingesta && .venv/bin/ruff format ingesta"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
