data/lago/geo/densidad_sectores.geojson
# Favelas trae nombre, ubicación y propiedad del terreno; raza o color es Sensible (F16-F17).
data/lago/geo/favelas.geojson
data/lago/empleo_raza.csv
data/lago/geo/buses.geojson
