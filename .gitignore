node_modules/
dist/
.venv/
__pycache__/
*.pyc
.vercel/
# Crudos: se regeneran con los scripts de ingesta (llevan fecha en el nombre).
data/raw/*
!data/raw/.gitkeep
*.tsbuildinfo
# Caché de calculos_p1.py (se regenera sola)
data/derivados/red_bus.gpkg
# Lago: se regeneran con `npm run datos`. densidad_sectores trae indice_vulnerabilidad (Sensible)
